{
  "name": "squirm",
  "version": "1.0.0",
  "private": true,
  "description": "A cozy turn-based worm puzzle in a 2.5D garden, built with three.js. Installable and playable offline.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farzinmirzaie/squirm.git"
  },
  "homepage": "https://farzinmirzaie.github.io/squirm/",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.js",
    "build:debug": "node tools/build.js --debug",
    "serve": "npx --yes serve dist",
    "verify": "node tools/verify-levels.js",
    "analyze": "node tools/analyze.js",
    "curate": "node tools/curate.js",
    "test": "npm run verify && npm run build"
  },
  "devDependencies": {
    "@fontsource/grandstander": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "three": "0.128.0"
  }
}
